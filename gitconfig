# To include this file, use:
#
# git config --local include.path ~/repos/nixpkgs/.m/gitconfig
#
# With the correct path of course
[fetch]
	# https://stackoverflow.com/a/41611648/4935114 - useful for this repository
	# in particular, as branches are deleted remotely regularly etc.
	prune = true
# Allow to work with intentionall mismatched branch names. A common example is
# a draft/ prefixed branch name which helps me remember it is currently in
# draft upstream, but the branch name exposed to others in the PR is
# intentionally not draft/ prefixed.
[push]
	default = upstream
[blame]
	ignoreRevsFile = .git-blame-ignore-revs

